rules_version = '2';

// 온나 라이브 교실 (ONNA LIVE) · Firestore 보안 규칙
//
// 아래는 '테스트 모드'와 같은 공개 규칙입니다. 수업용 공개 방이라
// 학생 로그인 없이 읽기/쓰기가 필요합니다.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 그대로 붙여넣고 [게시]하면 됩니다.
//
// ※ 테스트 모드는 만든 날부터 30일 뒤 자동으로 막힙니다. 그때는 이 규칙을 게시해 주세요.
// ※ 더 조이려면 아래 allow 를 방별로 나누고, 삭제(delete)를 막는 방법이 있습니다.
//
// v2 (2026-11-15): 3D 전시관 추가
//   - rooms/{room}/galleryPeers/{peerId} : 같은 방 아바타 위치·이모지 동기화 (퇴장 시 삭제 허용)
//   - rooms/{room}/works/{id}/comments/{cid} : 작품 칭찬 댓글
//
// v3 (2026-11-21): 0교시 손그림 3D 아바타
//   - rooms/{room}/sketches/{uid} : 학생 손그림 아바타 (문서 id = 학생 uid, 1인 1작품 덮어쓰기)
//     · image  : 400px JPEG base64 (앱에서 48,000자 이하로 압축 → 약 36KB)
//     · speech : 말풍선 한 마디 (최대 30자)
//     · likedBy: 하트(좋아요) — arrayUnion / arrayRemove
//     · delete 허용: 교사 모드 '손그림 전체 지우기'로 수업 후·테스트 정리

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{room} {
      allow read: if true;
      allow create, update: if true;   // 채팅 잠금 · 퀴즈 게시 · 전시관 제목(galleryTitle/gallerySub)
      allow delete: if false;          // 방 문서는 지우지 않음

      match /messages/{doc} {
        allow read: if true;
        allow create: if request.resource.data.text is string
                      && request.resource.data.text.size() <= 200;
        allow update, delete: if false; // 한 번 올린 채팅은 수정·삭제 불가
      }

      match /works/{doc} {
        allow read: if true;
        allow create: if request.resource.data.image is string
                      && request.resource.data.image.size() <= 400000;
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['likedBy']);   // 좋아요(하트)만 변경 허용
        allow delete: if false;

        // 작품 칭찬 댓글 (3D 전시관 · 작품 상세)
        match /comments/{cid} {
          allow read: if true;
          allow create: if request.resource.data.text is string
                        && request.resource.data.text.size() <= 80;
          allow update, delete: if false;
        }
      }

      match /reflections/{doc} {
        allow read: if true;
        allow create: if request.resource.data.text is string
                      && request.resource.data.text.size() <= 80;
        allow update, delete: if false;
      }

      // 3D 전시관 동시 접속 아바타 (위치·방향·이모지)
      // 2초 간격 + 실제로 움직였을 때만 쓰고, 나가면 문서를 지웁니다.
      match /galleryPeers/{peer} {
        allow read: if true;
        allow create, update: if request.resource.data.name is string
                              && request.resource.data.name.size() <= 12;
        allow delete: if true;          // 퇴장/탭 닫기 정리
      }

      // 0교시 · 손그림 3D 아바타 (문서 id = 학생 uid, 1인 1작품 덮어쓰기)
      match /sketches/{doc} {
        allow read: if true;
        allow create, update: if request.resource.data.image is string
                              && request.resource.data.image.size() <= 60000
                              && request.resource.data.speech is string
                              && request.resource.data.speech.size() <= 60;
        allow delete: if true;          // 교사 모드 '손그림 전체 지우기' (수업 후 정리)
      }
    }
  }
}
